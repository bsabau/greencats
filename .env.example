# Copy to .env and change both values. Generate the password with: openssl rand -hex 24
POSTGRES_PASSWORD=change-me
# Your server's public domain name. Its DNS record must point to the server.
DOMAIN=app.example.org

# How long a person's data is kept after the last contact, in days. 1825 = 5 years.
DATA_RETENTION_DAYS=1825
# How long the change log (who changed what, failed logins) is kept, in days.
AUDIT_RETENTION_DAYS=365
# A login unused for this many days ends.
SESSION_IDLE_DAYS=7

# Backups. Without a passphrase no backup is written. Generate one with: openssl rand -base64 32
# Keep a copy of it somewhere else: without it the backups cannot be read.
BACKUP_PASSPHRASE=
# Where backups are written on this server.
BACKUP_DIR=./backups
# Backups older than this are deleted from BACKUP_DIR.
BACKUP_RETENTION_DAYS=30
BACKUP_INTERVAL_HOURS=24
# Optional copy to cloud storage, for example gs://my-bucket/greencats.
# Needs a service-account key at ./secrets/gcs.json. Set a lifecycle rule on the bucket to delete old files.
BACKUP_REMOTE=

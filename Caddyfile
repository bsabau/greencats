{$DOMAIN} {
	encode zstd gzip
	# A cat's page receives photos of up to 10 MB. Every other form is a few kilobytes, so a larger
	# body is refused here, before the app reads it.
	@photoPage path_regexp ^/animals/[0-9a-fA-F-]{36}$
	request_body @photoPage {
		max_size 11MB
	}
	@otherPages not path_regexp ^/animals/[0-9a-fA-F-]{36}$
	request_body @otherPages {
		max_size 1MB
	}
	reverse_proxy app:3000
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
}
